pipeline {
    agent any
    
    stages {
        stage('Unit Tests - Backend') {
            agent {
                docker {
                    sh 'docker --version || true'; sh 'echo $DOCKER_HOST || true'; sh 'ping -c1 docker || true'
                    image 'snakee/golang-junit:1.21'
                    reuseNode true
                }
            }
            steps {
                dir('bugtracker-backend') {
                    sh 'go test -v ./...'
                }
            }
        }
    }
}